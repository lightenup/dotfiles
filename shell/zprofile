# The following lines were added by Docker Desktop to add commands to your PATH.
export PATH="$PATH:$HOME/.docker/bin"
# End of Docker Desktop section.

eval "$(/opt/homebrew/bin/brew shellenv)"

export PATH="$PATH:$HOME/.dotnet/tools"

# Zscaler terminates TLS for some hosts (the VS Code marketplace CDN among
# them). curl and Homebrew trust the keychain, node-based tools do not, so point
# them at the exported root CA. Regenerate with: task certs:zscaler
[ -r "$HOME/.config/certs/zscaler.pem" ] && export NODE_EXTRA_CA_CERTS="$HOME/.config/certs/zscaler.pem"
