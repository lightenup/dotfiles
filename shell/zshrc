HOMEBREW_PREFIX="${HOMEBREW_PREFIX:-/opt/homebrew}"

command -v fzf >/dev/null && source <(fzf --zsh)

alias tf='tofu'

fpath=(~/.zsh ~/.zsh/completions $fpath)

autoload -Uz compinit
compinit

autoload bashcompinit && bashcompinit
[ -r "$HOMEBREW_PREFIX/etc/bash_completion.d/az" ] && source "$HOMEBREW_PREFIX/etc/bash_completion.d/az"

# SUBL_HOME, ANDROID_HOME, INTELLIJ_HOME and LOCAL_BIN come from shell/env via
# shell/zshenv, which runs before this file. PATH is assembled here rather than
# there because /etc/zprofile runs path_helper after zshenv and reorders it.
# JAVA_HOME is deliberately absent — mise sets it for the active JDK.
export PATH="$HOME/bin:$SUBL_HOME:$ANDROID_HOME/emulator:$ANDROID_HOME/platform-tools:$INTELLIJ_HOME:$LOCAL_BIN:$PATH"
export NVM_DIR="$HOME/.nvm"
[ -s "$HOMEBREW_PREFIX/opt/nvm/nvm.sh" ] && . "$HOMEBREW_PREFIX/opt/nvm/nvm.sh"                              # loads nvm
[ -s "$HOMEBREW_PREFIX/opt/nvm/etc/bash_completion.d/nvm" ] && . "$HOMEBREW_PREFIX/opt/nvm/etc/bash_completion.d/nvm"
command -v nvm >/dev/null && nvm use default --silent >/dev/null 2>&1           # activate default node (v24 LTS)

DOTFILES_STATE_DIR="$HOME/.local/state/dotfiles"
DOTFILES_LAST_DRIFT="$DOTFILES_STATE_DIR/last-drift.log"
DOTFILES_WARN_MARKER="$DOTFILES_STATE_DIR/.drift-warning-$(date +%F)"

# Resolve the repo through this file's own symlink so the hint stays correct
# no matter where the clone lives.
DOTFILES_DIR="$(cd "$(dirname "$(dirname "$(readlink "$HOME/.zshrc" 2>/dev/null)")")" 2>/dev/null && pwd)"
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/Development/private/dotfiles}"

if [ -f "$DOTFILES_LAST_DRIFT" ] && [ ! -f "$DOTFILES_WARN_MARKER" ]; then
	echo "WARNING: dotfiles drift detected. Run: task -d $DOTFILES_DIR status"
	mkdir -p "$DOTFILES_STATE_DIR"
	touch "$DOTFILES_WARN_MARKER"
fi

alias start-zscaler="open -a /Applications/Zscaler/Zscaler.app --hide; sudo find /Library/LaunchDaemons -name '*zscaler*' -exec launchctl load {} \;"
alias kill-zscaler="find /Library/LaunchAgents -name '*zscaler*' -exec launchctl unload {} \;;sudo find /Library/LaunchDaemons -name '*zscaler*' -exec launchctl unload {} \;"

last_changed() {
  local count="${1:-5}"

  if [[ ! "$count" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "Usage: last_changed [NUMBER]" >&2
    return 1
  fi

  find . -type f -exec stat -t '%Y-%m-%d %H:%M:%S' -f '%m %Sm %N' {} + |
    LC_ALL=C sort -n -k1,1 |
    tail -n "$count" |
    cut -d' ' -f2-
}


#THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

# After SDKMAN on purpose: mise owns dotnet and java (JAVA_HOME included), and
# its per-prompt hook must win over anything SDKMAN prepends. Use mise, not
# `sdk install java`, for JDKs.
command -v mise >/dev/null && eval "$(mise activate zsh)"
export UNSLOTH_DIFFUSION_ALLOW_OVERSIZED_LOAD=1

# Added by LM Studio CLI (lms)
export PATH="$PATH:$HOME/.lmstudio/bin"
# End of LM Studio CLI section
# The following lines have been added by Docker Desktop to enable Docker CLI completions.
fpath=($HOME/.docker/completions $fpath)
autoload -Uz compinit
(( ${+_comps[docker]} )) || compinit
# End of Docker CLI completions
